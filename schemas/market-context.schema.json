{
  "type": "object",
  "properties": {
    "updated_at": {
      "type": "string"
    },
    "period_start": {
      "type": "string"
    },
    "period_end": {
      "type": "string"
    },
    "headline": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^20\\d{2}-\\d{2}-\\d{2}$"
          },
          "title": {
            "type": "string"
          },
          "fact": {
            "type": "string"
          },
          "market_impact": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "current_drivers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "japan_impact": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "japan_connection": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "route": {
            "type": "string"
          },
          "assessment": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "daily_life_impacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "mechanism": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "evidence_type": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "scenario_change_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "published_at": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-morning-gules.vercel.app/schemas/market-context.schema.json",
  "title": "Market Morning market-context v1",
  "description": "Current v1 contract. Unknown keys are allowed for forward compatibility.",
  "required": [
    "updated_at",
    "period_start",
    "period_end",
    "headline",
    "summary",
    "timeline",
    "current_drivers",
    "japan_connection",
    "daily_life_impacts",
    "scenario_change_conditions",
    "sources"
  ]
