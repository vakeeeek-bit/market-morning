{
  "type": "object",
  "required": ["updated_at", "market_date", "data_phase", "data_state", "source", "scope", "sector_ranking", "sector_stock_ranking", "trading_value_ranking", "volume_surge_ranking", "market_internals", "market_regime", "key_drivers", "rotation_read", "sector_quality", "scenario_review", "monitoring_points", "methodology", "data_quality"],
  "properties": {
    "updated_at": {"type": ["string", "null"]},
    "market_date": {"type": ["string", "null"]},
    "data_phase": {"type": "string"},
    "data_state": {"type": "object", "required": ["kind", "label", "message"], "properties": {"kind": {"enum": ["normal", "holiday", "data_error"]}}},
    "source": {"type": "string"},
    "scope": {"type": "string"},
    "sector_ranking": {"type": "array", "items": {"type": "object"}},
    "sector_stock_ranking": {"type": "array", "items": {"type": "object"}},
    "trading_value_ranking": {"type": "array", "items": {"type": "object"}},
    "volume_surge_ranking": {"type": "array", "items": {"type": "object"}},
    "market_internals": {"type": "object"},
    "market_regime": {
      "type": "object",
      "required": ["headline", "headline_reason", "scoreboard", "dimensions", "method_note"],
      "properties": {
        "headline": {"type": "string"},
        "divergence_alert": {"type": ["string", "null"]},
        "scoreboard": {"type": "array", "minItems": 4, "items": {"type": "object", "required": ["label", "value", "unit", "meaning"]}},
        "dimensions": {"type": "array", "items": {"type": "object", "required": ["axis", "label", "status", "reason"]}},
        "method_note": {"type": "string"}
      }
    },
    "key_drivers": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "object", "required": ["driver", "category", "assessment", "status", "reason", "affected_sectors", "impact_score"]}},
    "rotation_read": {
      "type": "object",
      "required": ["label", "items", "note"],
      "properties": {
        "label": {"const": "値動きから見たローテーション（推定）"},
        "items": {"type": "array", "items": {"type": "object", "required": ["axis", "label", "status", "reason"]}},
        "note": {"type": "string"}
      }
    },
    "sector_quality": {"type": "array", "items": {"type": "object", "required": ["sector", "change_pct", "quality", "axes", "comment", "coverage_note"], "properties": {"axes": {"type": "object", "required": ["momentum", "breadth", "activity", "persistence"]}}}},
    "scenario_review": {"type": "object", "required": ["title", "status", "previous_view", "market_result", "revision", "today_watch", "note"]},
    "monitoring_points": {"type": "array", "items": {"type": "object", "required": ["watch", "current_view", "change_condition", "pricing_status"]}},
    "methodology": {
      "type": "object",
      "required": ["tier_1_existing_data", "tier_2_light_fetch", "tier_3_new_api_or_ai", "implemented_tier"],
      "properties": {"implemented_tier": {"const": 1}}
    },
    "data_quality": {
      "type": "object",
      "required": ["sector_total", "sector_available", "stock_total", "stock_available", "date_alignment"],
      "properties": {
        "sector_total": {"type": "integer"},
        "sector_available": {"type": "integer"},
        "stock_total": {"type": "integer"},
        "stock_available": {"type": "integer"},
        "date_alignment": {
          "type": "object",
          "required": ["expected_market_date", "sector_market_date", "stock_market_date", "benchmark_market_date", "aligned", "benchmark_aligned"],
          "properties": {
            "expected_market_date": {"type": ["string", "null"]},
            "sector_market_date": {"type": ["string", "null"]},
            "stock_market_date": {"type": ["string", "null"]},
            "benchmark_market_date": {"type": ["string", "null"]},
            "aligned": {"type": "boolean"},
            "benchmark_aligned": {"type": "boolean"}
          }
        }
      }
    }
  },
  "additionalProperties": true
}
