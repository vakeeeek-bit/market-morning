{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-morning-gules.vercel.app/schemas/market-context.schema.json",
  "title": "Market Morning market-context v2",
  "type": "object",
  "required": ["version", "updated_at", "report_date", "period_start", "period_end", "freshness", "headline", "summary", "themes", "scenario_change_conditions", "sources"],
  "properties": {
    "version": {"const": 2},
    "updated_at": {"type": "string"},
    "report_date": {"type": "string", "pattern": "^20\\d{2}-\\d{2}-\\d{2}$"},
    "period_start": {"type": "string", "pattern": "^20\\d{2}-\\d{2}-\\d{2}$"},
    "period_end": {"type": "string", "pattern": "^20\\d{2}-\\d{2}-\\d{2}$"},
    "freshness": {
      "type": "object",
      "required": ["status", "latest_report_date", "source_report_count", "note"],
      "properties": {
        "status": {"enum": ["current", "stale"]},
        "latest_report_date": {"type": "string"},
        "source_report_count": {"type": "integer", "minimum": 2},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "headline": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "themes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["theme", "timeline", "initial_view", "new_fact", "market_reaction", "current_view", "japan_impact", "counter_evidence", "source_ids"],
        "properties": {
          "theme": {"type": "string", "minLength": 1},
          "timeline": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": ["date", "title", "fact", "market_impact", "source_ids"],
              "properties": {
                "date": {"type": "string", "pattern": "^20\\d{2}-\\d{2}-\\d{2}$"},
                "title": {"type": "string", "minLength": 1},
                "fact": {"type": "string", "minLength": 1},
                "market_impact": {"type": "string", "minLength": 1},
                "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
              }
            }
          },
          "initial_view": {"$ref": "#/$defs/stage"},
          "new_fact": {"$ref": "#/$defs/stage"},
          "market_reaction": {"$ref": "#/$defs/stage"},
          "current_view": {"type": "string", "minLength": 1},
          "japan_impact": {"type": "string", "minLength": 1},
          "counter_evidence": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "scenario_change_conditions": {"type": "array"},
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "title", "publisher", "published_at", "url"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "publisher": {"type": "string"},
          "published_at": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://.+$"}
        }
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": ["date", "text"],
      "properties": {
        "date": {"type": "string", "pattern": "^20\\d{2}-\\d{2}-\\d{2}$"},
        "text": {"type": "string", "minLength": 1}
      }
    }
  },
  "additionalProperties": true
}
